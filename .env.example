# Copy to .env and edit. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset to use local SQLite. For Postgres (docker compose up -d db):
# DATABASE_URL=postgres://sis:sis_dev_password@localhost:5432/sis
# Production only:
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://sis.example.com

# Attendance (optional). Weekdays with no school: Monday=0 ... Sunday=6 (default 4 = Friday).
# SCHOOL_NON_TEACHING_WEEKDAYS=4
# Days a teacher may go back to correct attendance (default 7).
# ATTENDANCE_EDIT_DAYS=7
